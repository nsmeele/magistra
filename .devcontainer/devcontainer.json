// VS Code Dev Container: attaches to the `app` service from docker-compose.yml,
// so the editor uses the container's Python and packages (no local venv needed).
{
  "name": "Magistra",
  "dockerComposeFile": ["../docker-compose.yml"],
  "service": "app",
  "workspaceFolder": "/app",

  // Also start the database and Vite alongside the app
  "runServices": ["app", "db", "vite"],

  // Keep the service's own command (python run.py) so the Flask app keeps running
  "overrideCommand": false,
  "shutdownAction": "stopCompose",

  "forwardPorts": [5001],

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.black-formatter",
        "ms-python.isort",
        "ms-python.flake8",
        "samuelcolvin.jinjahtml",
        "bradlc.vscode-tailwindcss"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"],
        "[python]": {
          "editor.defaultFormatter": "ms-python.black-formatter",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": { "source.organizeImports": "explicit" }
        }
      }
    }
  }
}
